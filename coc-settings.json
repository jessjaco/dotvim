{
  "languageserver": {
    "fortran": {
      "command": "fortls",
      "args": [
        "--notify_init",
        "--hover_signature",
        "--hover_language=fortran",
        "--use_signature_help"
      ],
      "filetypes": ["fortran", "f90", "f95", "f03", "f08"],
      "rootPatterns": [".git/"],
      "trace.server": "verbose"
    }
  },
  "coc.preferences.willSaveHandlerTimeout": 2000,
  "coc.preferences.formatOnSaveFiletypes": [
    "css",
    "markdown",
    "r",
    "python",
    "typescriptreact",
    "json",
    "jsonc"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportPrivateImportUsage": "none"
  },
  "python.formatting.provider": "black",
  "cSpell.showStatus": true,
  "cSpell.userWords": [
    "AUTOTUNE",
    "Colab",
    "Geospatial",
    "Keras",
    "Postgresql",
    "QGIS",
    "Tensorflow",
    "Unet",
    "conda",
    "convolutional",
    "covariates",
    "dask",
    "earthengine",
    "eleventy",
    "geopandas",
    "gtag",
    "headshot",
    "kubernetes",
    "mapbox",
    "ndarray",
    "numbersandstrings",
    "numpy",
    "pyright",
    "pytorch",
    "rasterio",
    "resnet",
    "sklearn",
    "stackoverflow",
    "tfrecord",
    "tidyverse",
    "tolist",
    "xarray",
    "xgboost",
    "xmax",
    "xmin",
    "ymax",
    "ymin"
  ],
  "cSpell.enabledLanguageIds": ["html", "markdown", "plaintext", "text"],
  "inlayHint.enable": false
}
